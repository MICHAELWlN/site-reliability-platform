# systemd unit for the FastAPI service running on the Ubuntu EC2 instance.

[Unit]
# Human-readable name shown by systemctl status.
Description=SRE Platform FastAPI Service
# Start this unit after basic network initialization.
After=network.target

[Service]
# Run the application as the normal Ubuntu EC2 user, not root.
User=ubuntu
# The repository is cloned into the Ubuntu user's home directory.
WorkingDirectory=/home/ubuntu/site-reliability-platform
# Use the Python interpreter from this project's virtual environment.
# Uvicorn listens only on localhost because Nginx will be the public entry point later.
ExecStart=/home/ubuntu/site-reliability-platform/.venv/bin/python -m uvicorn service.main:app --host 127.0.0.1 --port 8000
# Restart Uvicorn if the process unexpectedly fails.
Restart=on-failure
# Wait 5 seconds before attempting the restart.
RestartSec=5

[Install]
# Allow the service to start automatically during normal Ubuntu boot.
WantedBy=multi-user.target
